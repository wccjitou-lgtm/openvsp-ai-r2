 //==== Resize the main window ====//
+bool MainVSPScreen::LoadModelForEditing( const std::string& path )
+{
+    if ( path.empty() )
+    {
+        return false;
+    }
+    Vehicle* vehicle = VehicleMgr.GetVehicle();
+    if ( !vehicle )
+    {
+        return false;
+    }
+
+    // Same load path as File/Open..., so the generated AI/GA model replaces the
+    // current vehicle and becomes fully editable in the GUI.
+    vehicle->Renew();
+    vehicle->SetVSP3FileName( path );
+    vehicle->ReadXMLFile( path );
+
+    if ( m_GlWin )
+    {
+        BndBox bbox = vehicle->GetBndBox();
+        vec3d center = bbox.GetCenter();
+        if ( m_GlWin->getGraphicEngine() && m_GlWin->getGraphicEngine()->getDisplay() )
+        {
+            m_GlWin->getGraphicEngine()->getDisplay()->setCOR(
+                (float)-center.x(), (float)-center.y(), (float)-center.z() );
+        }
+        m_GlWin->redraw();
+    }
+    return true;
+}
