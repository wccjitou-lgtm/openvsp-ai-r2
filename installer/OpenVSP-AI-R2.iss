#define AppName "OpenVSP AI R2"
#define AppVersion "3.51.3-r2"
#define AppPublisher "wccjitou-lgtm"
#define AppURL "https://github.com/wccjitou-lgtm/openvsp-ai-r2"
#define PayloadDir "..\dist\OpenVSP-3.51.3-zh-CN-r2"

[Setup]
AppId={{A074AAAF-7191-49DE-954E-2EBE597039E5}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
DefaultDirName={localappdata}\Programs\OpenVSP AI R2
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
LicenseFile={#PayloadDir}\LICENSE
OutputDir=..\dist\installer
OutputBaseFilename=OpenVSP-AI-R2-Setup-{#AppVersion}
SetupIconFile={#PayloadDir}\vsp.ico
UninstallDisplayIcon={app}\vsp.exe
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
CloseApplications=no
RestartApplications=no
SetupLogging=yes
ChangesEnvironment=yes

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加任务:"; Flags: unchecked

[Files]
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\OpenVSP AI R2"; Filename: "{app}\vsp.exe"; WorkingDir: "{app}"
Name: "{autodesktop}\OpenVSP AI R2"; Filename: "{app}\vsp.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\vsp.exe"; Description: "启动 OpenVSP AI R2"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent

[Registry]
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_R2_ROOT"; ValueData: "{app}"
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_ROOT"; ValueData: "{app}"
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_PYTHONPATH"; ValueData: "{app}\python"
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_MCP_SERVER"; ValueData: "{app}\mcp\openvsp_mcp_server.py"
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_MCP_INSTALLER"; ValueData: "{app}\mcp\install_mcp.py"
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "OPENVSP_R2_VERSION"; ValueData: "{#AppVersion}"

[Code]
function SendMessageTimeout(hWnd: Integer; Msg: Cardinal; wParam: Integer;
  lParam: Integer; fuFlags: Cardinal; uTimeout: Cardinal;
  var lpdwResult: Cardinal): Integer;
  external 'SendMessageTimeoutW@user32.dll stdcall';

procedure BroadcastEnvironment();
var
  R: Cardinal;
begin
  SendMessageTimeout($FFFF, $001A, 0, 0, 2, 5000, R);
end;

function FindPython(): String;
var
  P: String;
begin
  P := ExpandConstant('{app}\.venv\Scripts\python.exe');
  if FileExists(P) then
  begin
    Result := P;
    exit;
  end;
  P := FileSearch('python.exe', GetEnv('PATH'));
  if P <> '' then
    Result := P
  else
    Result := 'python';
end;

procedure WriteInstallContext();
var
  P, S: String;
begin
  P := FindPython();
  S := '# Generated by OpenVSP AI R2 installer' + #13#10 +
       'APP_ROOT=' + ExpandConstant('{app}') + #13#10 +
       'PYTHON=' + P + #13#10 +
       'OPENVSP_ROOT=' + ExpandConstant('{app}') + #13#10 +
       'OPENVSP_PYTHONPATH=' + ExpandConstant('{app}\python') + #13#10 +
       'MCP_SERVER=' + ExpandConstant('{app}\mcp\openvsp_mcp_server.py') + #13#10 +
       'MCP_INSTALLER=' + ExpandConstant('{app}\mcp\install_mcp.py') + #13#10 +
       'VERSION={#AppVersion}' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\mcp\install_context.ini'), S, False);
end;

procedure RemoveOwnedEnv(Name, Expected: String);
var
  V: String;
begin
  if RegQueryStringValue(HKCU, 'Environment', Name, V) and (V = Expected) then
    RegDeleteValue(HKCU, 'Environment', Name);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    WriteInstallContext();
    BroadcastEnvironment();
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    RemoveOwnedEnv('OPENVSP_ROOT', ExpandConstant('{app}'));
    RemoveOwnedEnv('OPENVSP_R2_ROOT', ExpandConstant('{app}'));
    RemoveOwnedEnv('OPENVSP_PYTHONPATH', ExpandConstant('{app}\python'));
    RemoveOwnedEnv('OPENVSP_MCP_SERVER', ExpandConstant('{app}\mcp\openvsp_mcp_server.py'));
    RemoveOwnedEnv('OPENVSP_MCP_INSTALLER', ExpandConstant('{app}\mcp\install_mcp.py'));
    RemoveOwnedEnv('OPENVSP_R2_VERSION', '{#AppVersion}');
    BroadcastEnvironment();
  end;
end;
